---
import Logo from '../components/Logo.astro';
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>About | Fin & Games</title>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <style>
    body { background: #090d16; color: #f8fafc; font-family: system-ui, sans-serif; padding: 2rem 1.5rem; max-width: 800px; margin: 0 auto; line-height: 1.6; }
    a { color: #38bdf8; text-decoration: none; }
    header { padding-bottom: 2rem; border-bottom: 1px solid rgba(255,255,255,0.1); margin-bottom: 2rem; }
  </style>
</head>
<body>
  <header>
    <a href="/"><Logo size={36} /></a>
  </header>
  <main>
    <h1>About Fin & Games</h1>
    <p style="margin-top: 1rem; color: #94a3b8;">
      We are an independent simulation game studio crafting systems-driven games with a distinctly British perspective.
    </p>
  </main>
</body>
</html>
