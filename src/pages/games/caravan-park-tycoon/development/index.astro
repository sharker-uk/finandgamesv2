---
import Logo from "../../../../components/Logo.astro"; import BobTheSeagull from "../../../../components/BobTheSeagull.astro"; import { getCollection } from "astro:content";
const posts=(await getCollection("gameDevlogs",({data})=>!data.draft&&data.game==="caravan-park-tycoon")).sort((a,b)=>b.data.pubDate.valueOf()-a.data.pubDate.valueOf());
---
<!doctype html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Development | Caravan Park Tycoon</title><style>:root{--bg:#081018;--surface:#101c26;--border:#ffffff18;--accent:#fbbf24;--text:#f8fafc;--muted:#a8b6c4}*{box-sizing:border-box}body{margin:0;background:var(--bg);color:var(--text);font:16px/1.7 system-ui,sans-serif}.wrap{max-width:900px;margin:auto;padding:1.5rem}header{display:flex;justify-content:space-between;padding-bottom:1.5rem;border-bottom:1px solid var(--border)}nav{display:flex;gap:1rem;flex-wrap:wrap}nav a{color:var(--muted);text-decoration:none}.hero{padding:4rem 0 2rem}.eyebrow{color:var(--accent);font:500 .78rem monospace;text-transform:uppercase}.hero h1{font-size:3.5rem;line-height:1;margin:.7rem 0}.lead{color:var(--muted)}.post{display:block;background:var(--surface);border:1px solid var(--border);border-radius:14px;padding:1.5rem;margin:1rem 0;text-decoration:none;color:inherit}.post:hover{border-color:#fbbf2466}.meta{color:var(--muted);font:500 .75rem monospace}.post h2{margin:.5rem 0}.post p{color:var(--muted)}footer{margin-top:4rem;border-top:1px solid var(--border);padding:2rem 0;color:var(--muted)}</style></head><body><div class="wrap"><header><a href="/"><Logo size={42}/></a><nav><a href="/games/caravan-park-tycoon">Game</a><a href="/games/caravan-park-tycoon/development">Development</a><a href="/games/caravan-park-tycoon/roadmap">Roadmap</a><a href="/games/caravan-park-tycoon/expansions">Expansions</a></nav></header><main><section class="hero"><div class="eyebrow">Caravan Park Tycoon</div><h1>Development log</h1><p class="lead">Technical notes, design experiments, bugs and breakthroughs behind the park.</p></section>{posts.length?posts.map(post=><a class="post" href={"/games/caravan-park-tycoon/development/"+post.id}><div class="meta">{post.data.pubDate.toLocaleDateString('en-GB',{day:'numeric',month:'short',year:'numeric'})} · {post.data.author}</div><h2>{post.data.title}</h2><p>{post.data.description}</p></a>):<article class="post"><h2>No public devlogs yet.</h2><p>The new site deliberately starts clean. Future Caravan Park Tycoon devlogs will appear here.</p></article>}</main><footer><a href="/games/caravan-park-tycoon">← Back to Caravan Park Tycoon</a></footer></div><BobTheSeagull/></body></html>