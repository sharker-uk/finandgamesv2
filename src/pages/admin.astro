---
import Logo from "../components/Logo.astro";
---
<!doctype html>
<html lang="en">
<head>
<meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="robots" content="noindex,nofollow">
<title>Editorial desk | Fin & Games</title>
<style>
:root{color-scheme:light;--paper:#f7f3e9;--ink:#172d25;--green:#244d3a;--orange:#d96c3b;--line:#d8d2c4;--muted:#66736b;--panel:#fffdf8}
*{box-sizing:border-box}body{margin:0;background:var(--paper);color:var(--ink);font:16px/1.55 system-ui,sans-serif}a{color:var(--green)}button,input,select,textarea{font:inherit}button{cursor:pointer}.shell{max-width:1200px;margin:auto;padding:1rem clamp(1rem,4vw,3rem) 4rem}header{display:flex;align-items:center;justify-content:space-between;gap:1rem;padding:1rem 0;border-bottom:1px solid var(--line)}header a{text-decoration:none}.eyebrow{font:700 .75rem ui-monospace,monospace;text-transform:uppercase;letter-spacing:.09em;color:var(--orange)}h1{font-size:clamp(2.5rem,5vw,4rem);line-height:1.02;letter-spacing:-.04em;margin:.5rem 0}h2{margin:.2rem 0 1rem}.intro{max-width:68ch;color:var(--muted)}.notice{margin:1.2rem 0;padding:.9rem 1rem;background:#fffdf8;border:1px solid var(--line);border-radius:10px}.notice.error{border-color:#b42318;color:#8d1c13}.layout{display:grid;grid-template-columns:minmax(0,1.5fr) minmax(280px,.8fr);gap:1.3rem;align-items:start;margin-top:1.5rem}.panel{background:var(--panel);border:1px solid var(--line);border-radius:16px;padding:clamp(1rem,2vw,1.5rem);min-width:0}.field{display:grid;gap:.35rem;margin-bottom:1rem}.field label{font-weight:700;font-size:.9rem}.field small,.hint{color:var(--muted);font-size:.82rem}.field input,.field select,.field textarea{width:100%;min-width:0;border:1px solid #c9c4b8;border-radius:8px;background:white;padding:.7rem .8rem;color:var(--ink)}.field textarea{resize:vertical}.two{display:grid;grid-template-columns:1fr 1fr;gap:.8rem}.actions{display:flex;gap:.6rem;flex-wrap:wrap;margin-top:1rem}.btn{border:0;border-radius:8px;padding:.7rem 1rem;font-weight:750;background:var(--green);color:white}.btn.secondary{background:#e9e5d9;color:var(--ink)}.btn.orange{background:var(--orange)}.btn:disabled{opacity:.55;cursor:wait}.post-list{display:grid;gap:.7rem}.draft{border:1px solid var(--line);border-radius:10px;padding:.85rem}.draft h3{margin:0 0 .25rem;font-size:1rem}.draft p{margin:.2rem 0;color:var(--muted);font-size:.82rem;overflow-wrap:anywhere}.draft button{margin-top:.5rem}.preview{white-space:pre-wrap;overflow-wrap:anywhere;background:#f0ede5;border-radius:8px;padding:.9rem;min-height:8rem;font: .88rem/1.6 ui-monospace,monospace}.image-tools{border:1px dashed var(--line);border-radius:10px;padding:.8rem;margin:.5rem 0 1rem}.image-tools img{max-width:100%;max-height:200px;object-fit:contain}.hidden{display:none!important}.footer-note{font-size:.82rem;color:var(--muted);margin-top:1rem}@media(max-width:820px){.layout{grid-template-columns:1fr}.two{grid-template-columns:1fr}}@media(prefers-reduced-motion:reduce){*{scroll-behavior:auto!important;transition:none!important}}
</style>
</head>
<body><div class="shell">
<header><a href="/" aria-label="Fin & Games home"><Logo size={40}/></a><a href="/">← Back to the site</a></header>
<main>
<p class="eyebrow">Private editorial tools · Early build</p>
<h1>The editorial desk.</h1>
<p class="intro">Create and revise posts on the development branch, with image uploads and Markdown content. Nothing is published to the production site by saving a draft. Review the branch preview and merge approved work when you are ready.</p>
<div id="status" class="notice" role="status" aria-live="polite">Checking your authorised session…</div>
<div class="layout">
<section class="panel">
<h2 id="form-title">Start a post</h2>
<form id="editor">
<div class="field"><label for="type">Post type</label><select id="type" required><option value="blog">Studio blog — light British humour</option><option value="studio">Studio update — professional and factual</option><option value="news">News / announcement</option><option value="devlog">Game devlog — structured, playful patch notes</option></select><small>Each type gets its own editorial profile; studio updates and announcements live in the news collection with a distinct type marker.</small></div>
<div class="two">
<div class="field"><label for="title">Title</label><input id="title" maxlength="160" required placeholder="A title people can find"></div>
<div class="field"><label for="slug">URL slug</label><input id="slug" pattern="[a-z0-9]+(-[a-z0-9]+)*" required placeholder="lowercase-hyphenated"></div>
</div>
<div class="two">
<div class="field"><label for="date">Publication date</label><input id="date" type="date" required></div>
<div class="field"><label for="author">Author</label><input id="author" value="Fin & Games Team" required></div>
</div>
<div class="field"><label for="description">Summary / description</label><textarea id="description" rows="2" maxlength="320" required placeholder="A concise summary for listings and search engines"></textarea></div>
<div class="field hidden" id="game-field"><label for="game">Game slug</label><input id="game" value="caravan-park-tycoon" pattern="[a-z0-9]+(-[a-z0-9]+)*"><small>Must match a game folder, e.g. caravan-park-tycoon.</small></div>
<div class="field"><label for="tags">Tags</label><input id="tags" placeholder="development, behind-the-scenes, release"><small>Separate tags with commas.</small></div>
<div class="field"><label for="body">Article body (Markdown)</label><textarea id="body" rows="16" required placeholder="Write your article in Markdown…"></textarea><small>Headings, lists, links and Markdown image syntax are supported by the site content. Saving preserves Markdown as written.</small></div>
<div class="image-tools">
<strong>Images</strong>
<p class="hint">Upload JPEG, PNG, WebP, GIF or AVIF (up to 5 MB each). Images are stored in the repository's public/uploads folder and become part of the branch preview.</p>
<div class="field"><label for="image-file">Choose image</label><input id="image-file" type="file" accept="image/jpeg,image/png,image/webp,image/gif,image/avif"></div>
<div class="field"><label for="image-alt">Image alt text / caption</label><input id="image-alt" placeholder="Describe the image for accessibility"></div>
<div class="actions"><button class="btn secondary" type="button" id="upload-image">Upload image</button><button class="btn secondary" type="button" id="insert-image" disabled>Insert Markdown image</button><button class="btn secondary" type="button" id="set-cover" disabled>Use as cover image</button></div>
<div id="uploaded-image" class="hint" aria-live="polite"></div>
</div>
<div class="two">
<div class="field"><label for="cover-image">Cover image path (optional)</label><input id="cover-image" placeholder="/uploads/my-post/cover.jpg"></div>
<div class="field"><label for="cover-alt">Cover image alt text</label><input id="cover-alt" placeholder="Describe the cover image"></div>
</div>
<div class="actions"><button class="btn" id="save" type="submit">Save draft to development branch</button><button class="btn secondary" id="copyedit" type="button">AI copyedit this body</button><button class="btn secondary" id="new-post" type="button">Clear / new post</button></div>
<p class="footer-note">The original source is never sent to an external copyeditor automatically. AI copyediting, approval/promotion and rendered Markdown preview are separate next steps; for now this desk safely saves source Markdown and image assets.</p>
</form>
</section>
<aside class="panel">
<h2>Draft shelf</h2><p class="hint" id="branch-name">Loading branch…</p>
<div id="drafts" class="post-list"><p class="hint">Loading drafts…</p></div>
<h2 style="margin-top:1.6rem">Markdown preview</h2><p class="hint">Source preview only. The live renderer is not executed here, so pasted HTML is shown as text rather than run.</p>
<pre id="preview" class="preview">(Your Markdown will appear here.)</pre>
</aside>
</div>
</main>
</div>
<script>
type Draft = {path:string;sha:string;title:string;date:string;description:string;author:string;tags:string[];game:string;coverImage:string;coverAlt:string;body:string;type:string;draft:boolean};
const $ = (id:string) => document.getElementById(id) as HTMLInputElement;
const status = $("status");
const form = $("editor") as HTMLFormElement;
const draftsEl = $("drafts");
let currentPath = "";
let currentSha = "";
let uploaded: {url:string;name:string;alt:string}|null = null;
let slugManuallyEdited = false;
const today = new Date();
$("date").value = new Date(today.getTime()-today.getTimezoneOffset()*60000).toISOString().slice(0,10);
function message(text:string,error=false){status.textContent=text;status.classList.toggle("error",error);}
function slugify(text:string){return text.toLowerCase().normalize("NFKD").replace(/[^a-z0-9]+/g,"-").replace(/^-|-$/g,"").replace(/-+/g,"-");}
function typeChanged(){ $("game-field").classList.toggle("hidden",$("type").value!=="devlog"); }
$("type").addEventListener("change",typeChanged);
$("title").addEventListener("input",()=>{if(!slugManuallyEdited&&!currentPath)$("slug").value=slugify($("title").value);});
$("slug").addEventListener("input",()=>{slugManuallyEdited=true;});
$("body").addEventListener("input",()=>{$("preview").textContent=$("body").value||"(Your Markdown will appear here.)";});
function val(id:string){return $(id).value.trim();}
function resetForm(){
 form.reset();$("author").value="Fin & Games Team";$("game").value="caravan-park-tycoon";$("date").value=new Date(Date.now()-new Date().getTimezoneOffset()*60000).toISOString().slice(0,10);
 currentPath="";currentSha="";uploaded=null;slugManuallyEdited=false;
 $("form-title").textContent="Start a post";$("save").textContent="Save draft to development branch";
 $("insert-image").disabled=true;$("set-cover").disabled=true;$("uploaded-image").textContent="";
 $("preview").textContent="(Your Markdown will appear here.)";typeChanged();
}
$("new-post").addEventListener("click",resetForm);
function payload(){return {type:val("type"),title:val("title"),slug:val("slug"),date:val("date"),description:val("description"),author:val("author")||"Fin & Games Team",tags:val("tags").split(",").map(x=>x.trim()).filter(Boolean),game:val("game"),body:$("body").value,coverImage:val("cover-image"),coverAlt:val("cover-alt")};}
async function api(url:string,options:RequestInit={}){const r=await fetch(url,{...options,headers:{"Content-Type":"application/json",...(options.headers||{})},cache:"no-store"});const data=await r.json().catch(()=>({}));if(!r.ok)throw new Error(data.error||"Request failed ("+r.status+").");return data;}
async function loadDrafts(){
 try{
 const data=await api("/admin/api/posts",{headers:{Accept:"application/json"}});
 $("branch-name").textContent="Branch: "+data.branch+" · "+data.drafts.length+" draft(s)";
 draftsEl.replaceChildren();
 if(!data.drafts.length){const p=document.createElement("p");p.className="hint";p.textContent="No drafts yet. A quiet shelf is a good shelf.";draftsEl.append(p);return;}
 for(const d of data.drafts as Draft[]){
  if(currentPath===d.path)currentSha=d.sha;
  const card=document.createElement("article");card.className="draft";
  const h=document.createElement("h3");h.textContent=d.title;card.append(h);
  const p=document.createElement("p");p.textContent=d.type+" · "+d.date+" · "+d.path;card.append(p);
  const b=document.createElement("button");b.className="btn secondary";b.type="button";b.textContent="Edit draft";b.addEventListener("click",()=>fillDraft(d));card.append(b);
  const approve=document.createElement("button");approve.className="btn orange";approve.type="button";approve.textContent="Approve for dev preview";approve.addEventListener("click",async()=>{
   if(!confirm("Approve this post on the dev branch? It will appear on that branch's preview. Production changes only after you merge the approved dev branch into main."))return;
   approve.disabled=true;
   try{
    await api("/admin/api/posts",{method:"POST",body:JSON.stringify({...d,draft:false})});
    message("Approved on the dev branch. It is no longer a draft; production remains unchanged until merge.");
    await loadDrafts();
   }catch(e){message(e instanceof Error?e.message:"Could not approve this draft.",true);approve.disabled=false;}
  });card.append(approve);draftsEl.append(card);
 }
 }catch(e){message(e instanceof Error?e.message:"Could not load drafts.",true);draftsEl.replaceChildren();}
}
function fillDraft(d:Draft){
 currentPath=d.path;currentSha=d.sha;slugManuallyEdited=true;uploaded=null;
 $("type").value=d.type;$("title").value=d.title;$("slug").value=d.path.split("/").pop()!.replace(/\.md$/,"");$("date").value=d.date;
 $("description").value=d.description;$("author").value=d.author||"Fin & Games Team";$("tags").value=(d.tags||[]).join(", ");$("game").value=d.game||"caravan-park-tycoon";
 $("body").value=d.body;$("cover-image").value=d.coverImage||"";$("cover-alt").value=d.coverAlt||"";
 $("form-title").textContent="Edit draft";$("save").textContent="Update draft on development branch";
 $("preview").textContent=d.body||"(Empty article body.)";typeChanged();message("Loaded draft. Save to update it; GitHub will reject stale edits if the file changed.");
 window.scrollTo({top:0,behavior:"smooth"});
}
form.addEventListener("submit",async(e)=>{
 e.preventDefault();const button=$("save") as HTMLButtonElement;button.disabled=true;
 try{
 const d=payload();if(!d.title||!d.slug||!d.date||!d.description||!d.body)throw new Error("Complete the title, slug, date, description and article body first.");
 if(!/^[a-z0-9]+(?:-[a-z0-9]+)*$/.test(d.slug))throw new Error("Slug must use lowercase letters, numbers and hyphens.");
 const data={...d,...(currentPath?{path:currentPath,sha:currentSha}:{})};
 const result=await api("/admin/api/posts",{method:"POST",body:JSON.stringify(data)});
 currentPath=result.path;message("Draft saved on "+result.branch+". It is still marked as a draft and is not published to production.");
 await loadDrafts();
 }catch(e){message(e instanceof Error?e.message:"Could not save draft.",true);}
 finally{button.disabled=false;}
});
$("upload-image").addEventListener("click",async()=>{
 const file=$("image-file").files?.[0];if(!file){message("Choose an image first.",true);return;}
 if(file.size>5*1024*1024){message("Image is over 5 MB. Resize it before uploading.",true);return;}
 const slug=val("slug");if(!/^[a-z0-9]+(?:-[a-z0-9]+)*$/.test(slug)){message("Set a valid post slug before uploading images.",true);return;}
 const button=$("upload-image") as HTMLButtonElement;button.disabled=true;
 try{
 const bytes=new Uint8Array(await file.arrayBuffer());let binary="";for(let i=0;i<bytes.length;i+=0x8000)binary+=String.fromCharCode(...bytes.subarray(i,i+0x8000));
 const result=await api("/admin/api/assets",{method:"POST",body:JSON.stringify({slug,name:file.name,type:file.type,data:btoa(binary)})});
 uploaded={url:result.url,name:file.name,alt:val("image-alt")};$("uploaded-image").textContent="Uploaded: "+result.url;
 $("insert-image").disabled=false;$("set-cover").disabled=false;message("Image uploaded to the development branch.");
 }catch(e){message(e instanceof Error?e.message:"Could not upload image.",true);}
 finally{button.disabled=false;}
});
$("insert-image").addEventListener("click",()=>{
 if(!uploaded)return;const area=$("body") as HTMLTextAreaElement;const snippet="!["+uploaded.alt.replace(/\]/g,"\\]")+"]("+uploaded.url+")";
 const start=area.selectionStart,end=area.selectionEnd;area.setRangeText(snippet,start,end,"end");area.focus();$("preview").textContent=area.value;
});
$("set-cover").addEventListener("click",()=>{if(!uploaded)return;$("cover-image").value=uploaded.url;$("cover-alt").value=uploaded.alt;message("Cover image set. Save the draft to store its metadata.");});

$("copyedit").addEventListener("click",async()=>{
 const body=$("body").value;if(!body.trim()){message("Write or load an article before copyediting.",true);return;}
 const button=$("copyedit") as HTMLButtonElement;button.disabled=true;
 try{
  const result=await api("/admin/api/copyedit",{method:"POST",body:JSON.stringify({type:val("type"),body})});
  $("body").value=result.body;$("preview").textContent=result.body;
  message("AI copyedit complete using the "+result.profile+" profile. Please review every change before saving.");
 }catch(e){message(e instanceof Error?e.message:"Copyediting failed.",true);}
 finally{button.disabled=false;}
});
typeChanged();void loadDrafts();
</script>
</body>
</html>
