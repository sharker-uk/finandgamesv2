---
import Logo from "../../../components/Logo.astro";
import BobTheSeagull from "../../../components/BobTheSeagull.astro";
import { getCollection } from "astro:content";
const devlogs = (await getCollection("gameDevlogs", ({ data }) => !data.draft && data.game === "caravan-park-tycoon"))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="theme-color" content="#f6f0df" />
  <meta name="description" content="Build, grow and run your own British seaside holiday park in Caravan Park Tycoon, a cosy management game from Fin & Games." />
  <title>Caravan Park Tycoon — Your little corner of the coast</title>
  <style>
    :root {
      color-scheme: light;
      --paper: #f6f0df;
      --paper-deep: #e9dfc5;
      --ink: #243e32;
      --green: #315a43;
      --green-dark: #203e30;
      --sea: #8bbbc0;
      --sea-deep: #397b83;
      --orange: #d96f43;
      --yellow: #efc76b;
      --muted: #637267;
      --line: #cfc5a9;
      --serif: Georgia, "Times New Roman", serif;
      --sans: "Trebuchet MS", Arial, sans-serif;
    }
    * { box-sizing: border-box; }
    html { scroll-behavior: smooth; }
    body { margin: 0; background: var(--paper); color: var(--ink); font: 16px/1.65 var(--sans); }
    a { color: inherit; }
    a:focus-visible { outline: 3px solid var(--orange); outline-offset: 4px; }
    .shell { max-width: 1180px; margin: 0 auto; padding: 0 28px; }
    .topline { background: var(--green-dark); color: #f9f1db; font-size: .76rem; letter-spacing: .12em; text-transform: uppercase; text-align: center; padding: 9px 16px; }
    header { display: flex; justify-content: space-between; align-items: center; gap: 24px; padding: 20px 0; border-bottom: 1px solid var(--line); }
    .brand { display: flex; align-items: center; gap: 12px; text-decoration: none; font-weight: 800; }
    .brand-copy { display: grid; line-height: 1.2; }
    .brand-copy small { color: var(--muted); font-size: .68rem; font-weight: 600; letter-spacing: .12em; text-transform: uppercase; }
    nav { display: flex; align-items: center; justify-content: flex-end; flex-wrap: wrap; gap: 8px 22px; }
    nav a { color: var(--green); font-size: .88rem; font-weight: 700; text-decoration: none; }
    nav a:hover { color: var(--orange); }
    .hero { position: relative; display: grid; grid-template-columns: 1.05fr .95fr; align-items: center; gap: 34px; padding: 76px 0 68px; }
    .kicker, .section-label { color: var(--orange); font-size: .75rem; font-weight: 800; letter-spacing: .16em; text-transform: uppercase; }
    h1, h2, h3 { font-family: var(--serif); font-weight: 700; }
    h1 { max-width: 700px; font-size: clamp(3.3rem, 7.5vw, 6.8rem); line-height: .91; letter-spacing: -.065em; margin: 18px 0 22px; }
    h1 em { color: var(--orange); font-weight: 700; }
    .intro { max-width: 590px; color: #526559; font-size: clamp(1.05rem, 1.7vw, 1.25rem); }
    .actions { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 28px; }
    .btn { display: inline-flex; align-items: center; justify-content: center; min-height: 48px; padding: 12px 19px; border: 2px solid var(--green); border-radius: 4px; font-size: .9rem; font-weight: 800; text-decoration: none; transition: transform .18s, background .18s; }
    .btn:hover { transform: translateY(-2px); }
    .btn.primary { background: var(--green); color: #fff8e8; }
    .btn.secondary { color: var(--green); }
    .scene { min-height: 390px; position: relative; overflow: hidden; isolation: isolate; border: 2px solid var(--green); border-radius: 48% 48% 8px 8px / 26% 26% 8px 8px; background: #8bbbc0; box-shadow: 10px 10px 0 var(--paper-deep); }
    .scene img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: center; }
    .scene:after { content: ""; position: absolute; inset: 40% 0 0; background: linear-gradient(transparent, #203e3066); pointer-events: none; }
    .sun { position: absolute; top: 36px; right: 52px; width: 66px; height: 66px; border-radius: 50%; background: var(--yellow); }
    .cloud { position: absolute; top: 70px; left: 44px; width: 100px; height: 24px; border-radius: 30px; background: #f9f4e4; }
    .cloud:before, .cloud:after { content: ""; position: absolute; bottom: 5px; border-radius: 50%; background: inherit; }
    .cloud:before { width: 36px; height: 36px; left: 16px; }
    .cloud:after { width: 27px; height: 27px; left: 48px; }
    .hill { position: absolute; bottom: 90px; width: 120%; height: 150px; border-radius: 50% 50% 0 0; }
    .hill.back { left: -28%; background: #8eaf79; transform: rotate(-8deg); }
    .hill.front { bottom: -22px; left: 18%; background: #547d51; transform: rotate(8deg); }
    .sea-stripe { position: absolute; left: 0; right: 0; bottom: 104px; height: 24px; background: repeating-linear-gradient(0deg, #6da5a5 0 4px, #9fc8be 4px 8px); transform: rotate(-2deg); }
    .caravan { position: absolute; z-index: 2; width: 150px; height: 90px; bottom: 84px; left: 50%; transform: translateX(-50%); border: 3px solid var(--green-dark); border-radius: 8px 8px 4px 4px; background: #f5e8c6; box-shadow: inset 0 -13px #d7c79e; }
    .caravan:before { content: ""; position: absolute; width: 20px; height: 29px; left: 20px; top: 18px; border: 3px solid var(--green-dark); background: var(--sea); }
    .caravan:after { content: ""; position: absolute; width: 25px; height: 23px; right: 18px; top: 18px; border: 3px solid var(--green-dark); background: var(--sea); }
    .wheel { position: absolute; z-index: 3; bottom: 71px; left: calc(50% - 39px); width: 22px; height: 22px; border: 5px solid var(--green-dark); border-radius: 50%; background: var(--paper); }
    .wheel.two { left: calc(50% + 18px); }
    .flag { position: absolute; z-index: 2; bottom: 170px; left: 19%; width: 3px; height: 76px; background: var(--green-dark); }
    .flag:after { content: ""; position: absolute; top: 0; left: 3px; width: 40px; height: 24px; background: var(--orange); clip-path: polygon(0 0,100% 0,80% 50%,100% 100%,0 100%); }
    .scene-stamp { position: absolute; z-index: 4; right: 17px; bottom: 18px; background: var(--paper); border: 2px solid var(--green); padding: 8px 12px; font-size: .68rem; font-weight: 900; letter-spacing: .1em; text-transform: uppercase; transform: rotate(3deg); }
    .ticker { border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); padding: 13px 0; color: var(--green); font-size: .75rem; font-weight: 800; letter-spacing: .14em; text-align: center; text-transform: uppercase; }
    .ticker span { color: var(--orange); padding: 0 12px; }
    .section { padding: 70px 0; }
    .inspiration-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 18px; margin-top: 30px; }
    .inspiration-card { margin: 0; background: #fbf7ec; border: 1px solid var(--line); }
    .inspiration-card img { display: block; width: 100%; aspect-ratio: 16 / 10; object-fit: cover; }
    .inspiration-card figcaption { padding: 16px 18px 18px; }
    .inspiration-card h3 { margin: 0 0 5px; font-size: 1.25rem; }
    .inspiration-card p { margin: 0; color: var(--muted); font-size: .82rem; }
    .image-credit { margin-top: 16px; color: var(--muted); font-size: .75rem; }
    .image-credit a { color: var(--green); }
    .section-heading { display: flex; align-items: end; justify-content: space-between; gap: 24px; margin-bottom: 28px; }
    h2 { margin: 8px 0 0; font-size: clamp(2.2rem, 4.2vw, 3.6rem); line-height: 1; letter-spacing: -.045em; }
    .section-heading p { max-width: 410px; margin: 0; color: var(--muted); }
    .feature-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; }
    .feature { min-height: 230px; padding: 24px; border: 1px solid var(--line); background: #fbf7ec; }
    .feature:nth-child(2) { background: #e4eeee; }
    .feature:nth-child(3) { background: #f4e2d2; }
    .feature .icon { display: block; margin-bottom: 28px; font-size: 2rem; }
    .feature h3 { margin: 0 0 10px; font-size: 1.55rem; }
    .feature p { margin: 0; color: #5a6a5e; font-size: .94rem; }
    .dev-section { background: var(--green-dark); color: #f8f0dc; }
    .dev-section .section-label { color: var(--yellow); }
    .dev-section .section-heading p { color: #d1d8c8; }
    .devlogs { display: grid; grid-template-columns: repeat(3, 1fr); gap: 14px; }
    .devlog { display: block; padding: 22px; border: 1px solid #ffffff35; color: inherit; text-decoration: none; }
    .devlog:hover { background: #ffffff0b; border-color: var(--yellow); }
    .meta { color: var(--yellow); font-size: .72rem; font-weight: 800; letter-spacing: .08em; text-transform: uppercase; }
    .devlog h3 { margin: 12px 0 8px; font-size: 1.4rem; }
    .devlog p { color: #d1d8c8; font-size: .9rem; }
    .dev-more { margin-top: 22px; }
    .dev-more a { color: var(--yellow); font-weight: 800; }
    .closing { display: flex; align-items: center; justify-content: space-between; gap: 24px; padding: 48px 0; }
    .closing p { max-width: 560px; color: var(--muted); }
    footer { border-top: 1px solid var(--line); padding: 22px 0 30px; color: var(--muted); font-size: .82rem; }
    footer .foot-inner { display: flex; justify-content: space-between; flex-wrap: wrap; gap: 12px; }
    footer a { color: var(--green); font-weight: 700; }
    @media (max-width: 820px) { .hero { grid-template-columns: 1fr; padding: 54px 0; } .scene { min-height: 330px; } .section-heading { align-items: flex-start; flex-direction: column; } .feature-grid, .devlogs, .inspiration-grid { grid-template-columns: 1fr; } .feature { min-height: 0; } .feature .icon { margin-bottom: 14px; } .closing { align-items: flex-start; flex-direction: column; } }
    @media (max-width: 560px) { .shell { padding: 0 18px; } header { align-items: flex-start; flex-direction: column; } nav { justify-content: flex-start; gap: 8px 15px; } h1 { font-size: clamp(3.1rem, 17vw, 5rem); } .scene { min-height: 285px; } .actions .btn { flex: 1 1 100%; } }
    @media (prefers-reduced-motion: reduce) { html { scroll-behavior: auto; } *, *:before, *:after { transition: none !important; } }
  </style>
</head>
<body>
  <div class="topline">A little British holiday park management game · In development</div>
  <div class="shell">
    <header>
      <a class="brand" href="/" aria-label="Fin & Games home">
        <Logo size={42} />
        <span class="brand-copy"><span>Caravan Park Tycoon</span><small>A Fin & Games project</small></span>
      </a>
      <nav aria-label="Game navigation">
        <a href="/games/caravan-park-tycoon/features">The game</a>
        <a href="/games/caravan-park-tycoon/development">Dev log</a>
        <a href="/games/caravan-park-tycoon/roadmap">Roadmap</a>
        <a href="/games/caravan-park-tycoon/expansions">What's next</a>
      </nav>
    </header>
    <main>
      <section class="hero">
        <div>
          <div class="kicker">Your plot. Your park. Your rules.</div>
          <h1>A little slice of <em>holiday</em> heaven.</h1>
          <p class="intro">Turn an overgrown patch of the British coast into a holiday park worth coming back to. Build pitches, keep your guests happy, make the books balance — and keep one eye on the local wildlife.</p>
          <div class="actions">
            <a class="btn primary" href="/games/caravan-park-tycoon/features">Explore the game</a>
            <a class="btn secondary" href="/games/caravan-park-tycoon/development">Follow development ↗</a>
          </div>
        </div>
        <div class="scene" role="img" aria-label="A stylised illustration of a caravan on a green seaside holiday park">
          <img src="https://images.pexels.com/photos/18026360/pexels-photo-18026360.jpeg?auto=compress&amp;cs=tinysrgb&amp;w=1400" alt="Static caravans beside the coast on a summer day" loading="eager" fetchpriority="high" /><div class="scene-stamp">Welcome to the coast</div>
        </div>
      </section>
    </main>
  </div>
  <div class="ticker">Make a pitch <span>✳</span> Build a business <span>✳</span> Mind the seagulls <span>✳</span> Repeat</div>
  <div class="shell">
    <section class="section">
      <div class="section-heading">
        <div><div class="section-label">A park to call your own</div><h2>Small pitches.<br />Big plans.</h2></div>
        <p>Start with the basics, make clever choices and turn your little corner of the coast into somewhere guests love to visit.</p>
      </div>
      <div class="feature-grid">
        <article class="feature"><span class="icon" aria-hidden="true">🌿</span><h3>Make it yours</h3><p>Clear the overgrowth, shape the land and lay out a park that feels like your own.</p></article>
        <article class="feature"><span class="icon" aria-hidden="true">🚐</span><h3>Keep the guests happy</h3><p>Build pitches and facilities, balance your budget and give visitors a reason to stay.</p></article>
        <article class="feature"><span class="icon" aria-hidden="true">🦅</span><h3>Respect the locals</h3><p>There is a pecking order around here. Bob the Mighty would like a word.</p></article>
      </div>
      <div class="inspiration-grid">
        <figure class="inspiration-card">
          <img src="https://images.unsplash.com/photo-1668455224783-3354979e8810?auto=format&amp;fit=crop&amp;w=1200&amp;q=85" alt="Coastal landscape at Ladram Bay Holiday Park in Devon" loading="lazy" />
          <figcaption><h3>A proper British coast</h3><p>Coastal atmosphere and scenery, inspired by the real holiday parks that give the game its setting.</p></figcaption>
        </figure>
        <figure class="inspiration-card">
          <img src="https://images.pexels.com/photos/14766771/pexels-photo-14766771.jpeg?auto=compress&amp;cs=tinysrgb&amp;w=1200" alt="Aerial view of a coastal campsite with rows of recreational vehicles" loading="lazy" />
          <figcaption><h3>Plan the whole park</h3><p>An aerial view to help communicate the scale and layout of a holiday park.</p></figcaption>
        </figure>
      </div>
      <p class="image-credit">Photography: <a href="https://unsplash.com/photos/a-body-of-water-with-land-and-buildings-around-it-n6pu1GCCqz8" target="_blank" rel="noreferrer">Sarah Doffman / Unsplash</a>; <a href="https://www.pexels.com/photo/static-caravans-on-the-seashore-18026360/" target="_blank" rel="noreferrer">Andras Stefuca / Pexels</a>; <a href="https://www.pexels.com/photo/aerial-photo-of-a-seaside-campsite-with-recreational-vehicles-14766771/" target="_blank" rel="noreferrer">Viktoria B. / Pexels</a>. Used under the respective free-photo licences.</p>
    </section>
  </div>
  <section class="dev-section">
    <div class="shell section">
      <div class="section-heading">
        <div><div class="section-label">Notes from the site office</div><h2>Work in progress.</h2></div>
        <p>Follow along as the park takes shape, from early prototypes to the little details that make it feel alive.</p>
      </div>
      <div class="devlogs">
        {devlogs.length ? devlogs.map(post => <a class="devlog" href={"/games/caravan-park-tycoon/development/" + post.id}>
          <div class="meta">{post.data.pubDate.toLocaleDateString("en-GB", { day: "numeric", month: "short", year: "numeric" })}</div>
          <h3>{post.data.title}</h3><p>{post.data.description}</p>
        </a>) : <article class="devlog"><div class="meta">Coming soon</div><h3>The first notes from the site office</h3><p>No public devlogs just yet. Check back as development continues.</p></article>}
      </div>
      <div class="dev-more"><a href="/games/caravan-park-tycoon/development">Read all development notes →</a></div>
    </div>
  </section>
  <div class="shell">
    <section class="closing">
      <div><div class="section-label">Fancy a look around?</div><h2>There's work to be done.</h2><p>The park is still growing. Take a look at the plans, see what's being built and follow the journey from the very first pitch.</p></div>
      <a class="btn primary" href="/games/caravan-park-tycoon/roadmap">See the roadmap →</a>
    </section>
    <footer><div class="foot-inner"><span>© {new Date().getFullYear()} Fin & Games · Caravan Park Tycoon</span><a href="/">Back to the studio</a></div></footer>
  </div>
  <BobTheSeagull />
</body>
</html>
