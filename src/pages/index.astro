---
import BobTheSeagull from "../components/BobTheSeagull.astro";
import { getCollection } from 'astro:content';
import Logo from '../components/Logo.astro';
const allDevlogs = await getCollection('devlogs', ({ data }) => !data.draft);
const latestDevlogs = allDevlogs.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()).slice(0, 3);
---
<!DOCTYPE html>
<html lang="en">
<head>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content="Fin & Games is an independent game studio creating Caravan Park Tycoon, a cosy management game with a distinctly British flavour." />
  <title>Fin & Games | Independent Game Studio</title>
  <link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
  <style>
    :root{--bg:#081018;--surface:#101c26;--surface2:#162632;--border:rgba(255,255,255,.09);--accent:#fbbf24;--sea:#38bdf8;--text:#f8fafc;--muted:#a8b6c4;--green:#6ee7b7}*{box-sizing:border-box;margin:0;padding:0}html{scroll-behavior:smooth}body{font-family:'Plus Jakarta Sans',system-ui,sans-serif;color:var(--text);background:var(--bg);background-image:radial-gradient(ellipse 80% 55% at 50% -15%,rgba(56,189,248,.14),transparent 65%);line-height:1.6;min-height:100vh}a{color:inherit}.container{width:min(1120px,calc(100% - 2rem));margin:auto}header{display:flex;align-items:center;justify-content:space-between;gap:1rem;padding:1.5rem 0;border-bottom:1px solid var(--border)}.brand{display:inline-flex}nav{display:flex;flex-wrap:wrap;gap:1.25rem}nav a{color:var(--muted);text-decoration:none;font-size:.92rem;font-weight:600}nav a:hover{color:var(--text)}.nav-support{color:var(--accent)}.hero{padding:6rem 0 5rem;display:grid;grid-template-columns:1.25fr .75fr;gap:3rem;align-items:center}.eyebrow{color:var(--accent);font:500 .78rem 'JetBrains Mono',monospace;letter-spacing:.1em;text-transform:uppercase;margin-bottom:1rem}h1{font-size:clamp(3rem,8vw,6rem);line-height:.96;letter-spacing:-.055em;margin-bottom:1.5rem}.hero-copy{font-size:1.18rem;color:var(--muted);max-width:680px}.hero-copy strong{color:var(--text)}.actions{display:flex;flex-wrap:wrap;gap:.8rem;margin-top:2rem}.button{display:inline-flex;align-items:center;justify-content:center;padding:.8rem 1.1rem;border-radius:9px;text-decoration:none;font-weight:700;border:1px solid var(--border);background:var(--surface)}.button:hover{border-color:rgba(251,191,36,.45);transform:translateY(-1px)}.button-primary{background:var(--accent);color:#241b05;border-color:var(--accent)}.hero-note{background:var(--surface);border:1px solid var(--border);border-radius:18px;padding:1.5rem;transform:rotate(2deg);box-shadow:0 20px 60px rgba(0,0,0,.2)}.hero-note .tiny{font:500 .72rem 'JetBrains Mono',monospace;color:var(--sea)}.hero-note h2{font-size:1.55rem;margin:.7rem 0}.hero-note p{color:var(--muted)}.hero-note .gull{text-align:right;font-size:4rem;margin-top:1rem}section{padding:4.5rem 0}.section-heading{display:flex;align-items:end;justify-content:space-between;gap:1rem;margin-bottom:1.5rem}.section-heading h2{font-size:clamp(1.7rem,4vw,2.5rem);letter-spacing:-.035em}.link{color:var(--accent);text-decoration:none;font-weight:700}.game-card{display:grid;grid-template-columns:1fr .8fr;overflow:hidden;border:1px solid var(--border);border-radius:18px;background:var(--surface)}.game-copy{padding:2.2rem}.status{display:inline-block;color:var(--green);background:rgba(110,231,183,.1);border:1px solid rgba(110,231,183,.2);border-radius:999px;padding:.3rem .65rem;font:500 .72rem 'JetBrains Mono',monospace;text-transform:uppercase}.game-copy h3{font-size:clamp(2rem,5vw,3.2rem);line-height:1;letter-spacing:-.045em;margin:1rem 0}.game-copy p,.feature p,.devlog-card p,.support p{color:var(--muted)}.game-copy ul{list-style:none;display:grid;gap:.55rem;margin:1.5rem 0}.game-copy li::before{content:'✓';color:var(--accent);margin-right:.6rem}.game-art{min-height:360px;display:flex;align-items:center;justify-content:center;padding:2rem;background:linear-gradient(145deg,rgba(56,189,248,.1),rgba(251,191,36,.08));border-left:1px solid var(--border)}.park-sign{width:min(280px,100%);padding:2rem 1.5rem;text-align:center;border:2px solid rgba(255,255,255,.18);border-radius:12px;background:rgba(8,16,24,.72)}.park-sign .sun{font-size:3.2rem}.park-sign h4{font-size:1.45rem;margin:.4rem 0}.park-sign p{color:var(--muted);font-size:.85rem}.feature-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:1rem}.feature,.support,.devlog-card{background:var(--surface);border:1px solid var(--border);border-radius:14px}.feature{padding:1.5rem}.feature-icon{font-size:1.7rem}.feature h3{margin:.65rem 0 .35rem}.support{padding:2.2rem;background:linear-gradient(135deg,rgba(251,191,36,.1),rgba(56,189,248,.07))}.support h2{font-size:2rem;margin-bottom:.6rem}.devlog-grid{display:grid;gap:.8rem}.devlog-card{display:block;padding:1.35rem 1.5rem;text-decoration:none}.devlog-card:hover{background:var(--surface2);border-color:rgba(251,191,36,.45)}.devlog-meta{color:var(--muted);font:500 .75rem 'JetBrains Mono',monospace;margin-bottom:.35rem}.devlog-card h3{font-size:1.15rem;margin-bottom:.3rem}footer{margin-top:4rem;padding:2.5rem 0;border-top:1px solid var(--border);color:var(--muted);font-size:.85rem}footer div{display:flex;justify-content:space-between;gap:1rem;flex-wrap:wrap}@media(max-width:800px){.hero,.game-card{grid-template-columns:1fr}.game-art{min-height:260px;border-left:0;border-top:1px solid var(--border)}.feature-grid{grid-template-columns:1fr}header{align-items:flex-start;flex-direction:column}.hero{padding-top:4rem}}
  </style>
</head>
<body><div class="container">
<header><a href="/" class="brand" aria-label="Fin & Games Home"><Logo size={42}/></a><nav aria-label="Main navigation"><a href="/games">Game</a><a href="/devlogs">Devlog</a><a href="/npc-builder">NPC Builder</a><a href="/about">About</a><a class="nav-support" href="/support">Support</a></nav></header>
<main>
<section class="hero"><div><div class="eyebrow">Independent game studio · Norfolk, UK</div><h1>Games with a little British character.</h1><p class="hero-copy">Fin & Games is an independent studio making <strong>Caravan Park Tycoon</strong>, a cosy management game inspired by Stardew Valley and the wonderfully strange world of the British holiday park.</p><div class="actions"><a class="button button-primary" href="/games">Meet the game</a><a class="button" href="/devlogs">Read the devlog</a></div></div><aside class="hero-note"><div class="tiny">CURRENT STATUS</div><h2>One park. Too many gulls.</h2><p>We're building the systems, characters and odd little details that make the park feel alive.</p><div class="gull" aria-hidden="true">🐦</div></aside></section>
<section><div class="section-heading"><div><div class="eyebrow">Our first game</div><h2>Caravan Park Tycoon</h2></div><a class="link" href="/games">Explore the game →</a></div><div class="game-card"><div class="game-copy"><span class="status">In development</span><h3>Build the park. Keep the guests happy.</h3><p>Start with an overgrown plot of land and turn it into a thriving British holiday park. Clear trees, create pitches, build facilities and balance the look of your park against the money it can make.</p><ul><li>Cosy management and simulation</li><li>British seaside and holiday-park flavour</li><li>Custom tents, caravans and park details</li><li>Characters, secrets and plenty of personality</li></ul><a class="button" href="/games">See what we're building</a></div><div class="game-art"><div class="park-sign"><div class="sun">☀️</div><h4>FIN & GAMES<br>HOLIDAY PARK</h4><p>Now featuring an unreasonable number of seagulls.</p></div></div></div></section>
<section><div class="section-heading"><div><div class="eyebrow">The idea</div><h2>More than placing buildings</h2></div></div><div class="feature-grid"><article class="feature"><div class="feature-icon">🌳</div><h3>Shape the land</h3><p>Clear the overgrown starting area and decide what stays, what goes and what becomes part of the park.</p></article><article class="feature"><div class="feature-icon">🚐</div><h3>Make it yours</h3><p>Build pitches and facilities, then customise the park with tents, caravans and details that give it character.</p></article><article class="feature"><div class="feature-icon">👑</div><h3>Mind the King</h3><p>Treat Bob the Mighty well. He is, after all, King of the Seagulls.</p></article></div></section>
<section><div class="support"><div class="eyebrow">Want to be part of the game?</div><h2>Support the studio. Become a character.</h2><p>The NPC Builder is currently a prototype. The longer-term plan is to let supporters create their own character and, subject to moderation and the final game systems, put themselves into Caravan Park Tycoon.</p><div class="actions"><a class="button button-primary" href="/support">Find out about supporting Fin & Games</a><a class="button" href="/npc-builder">See the NPC prototype</a></div></div></section>
<section><div class="section-heading"><div><div class="eyebrow">Open development</div><h2>From the dev bunker</h2></div><a class="link" href="/devlogs">View all ({allDevlogs.length}) →</a></div><div class="devlog-grid">{latestDevlogs.length > 0 ? latestDevlogs.map((post) => <a href={`/devlogs/${post.id}`} class="devlog-card"><div class="devlog-meta"><time datetime={post.data.pubDate.toISOString()}>{post.data.pubDate.toLocaleDateString('en-GB',{day:'numeric',month:'short',year:'numeric'})}</time></div><h3>{post.data.title}</h3><p>{post.data.description}</p></a>) : <p class="devlog-card">No devlogs published yet.</p>}</div></section>
</main><footer><div><span>© {new Date().getFullYear()} Fin & Games</span><span>Built with Astro & Cloudflare</span></div></footer></div><BobTheSeagull/></body></html>