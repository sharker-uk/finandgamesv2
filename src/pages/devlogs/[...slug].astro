---
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('devlogs');
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{post.data.title} | Fin & Games Devlog</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
  
  <style>
    :root {
      --bg: #090d16;
      --bg-surface: #111827;
      --bg-surface-elevated: #1a2234;
      --border: rgba(255, 255, 255, 0.08);
      --border-hover: rgba(56, 189, 248, 0.35);
      --accent: #38bdf8;
      --accent-glow: rgba(56, 189, 248, 0.15);
      --text: #f8fafc;
      --text-muted: #94a3b8;
      --tag-bg: rgba(56, 189, 248, 0.1);
    }

    * { box-sizing: border-box; margin: 0; padding: 0; }

    body {
      font-family: 'Plus Jakarta Sans', system-ui, sans-serif;
      background-color: var(--bg);
      background-image: 
        radial-gradient(ellipse 80% 50% at 50% -20%, rgba(56, 189, 248, 0.12), transparent),
        radial-gradient(circle at 100% 100%, rgba(14, 165, 233, 0.05), transparent 40%);
      background-repeat: no-repeat;
      color: var(--text);
      line-height: 1.7;
      min-height: 100vh;
      display: flex;
      flex-direction: column;
    }

    .container {
      max-width: 820px;
      margin: 0 auto;
      padding: 2.5rem 1.5rem;
      width: 100%;
    }

    /* Header */
    header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding-bottom: 2rem;
      border-bottom: 1px solid var(--border);
    }

    .brand {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      text-decoration: none;
      font-weight: 800;
      font-size: 1.25rem;
      letter-spacing: -0.02em;
      color: var(--text);
    }

    .brand-mark {
      width: 10px;
      height: 10px;
      border-radius: 50%;
      background: var(--accent);
      box-shadow: 0 0 12px var(--accent);
    }

    .brand span { color: var(--accent); }

    .back-link {
      display: inline-flex;
      align-items: center;
      gap: 0.4rem;
      color: var(--text-muted);
      text-decoration: none;
      font-size: 0.9rem;
      font-weight: 500;
      transition: color 0.15s ease;
    }

    .back-link:hover { color: var(--accent); }

    /* Post Header */
    .post-header {
      margin: 3.5rem 0 2.5rem;
      border-bottom: 1px solid var(--border);
      padding-bottom: 2rem;
    }

    .post-meta {
      display: flex;
      align-items: center;
      gap: 0.75rem;
      font-family: 'JetBrains Mono', monospace;
      font-size: 0.85rem;
      color: var(--text-muted);
      margin-bottom: 1rem;
    }

    .post-title {
      font-size: clamp(2rem, 4vw, 2.75rem);
      font-weight: 800;
      line-height: 1.2;
      letter-spacing: -0.03em;
      margin-bottom: 1rem;
    }

    .post-desc {
      color: var(--text-muted);
      font-size: 1.15rem;
      line-height: 1.6;
    }

    .tags {
      display: flex;
      gap: 0.5rem;
      margin-top: 1.25rem;
      flex-wrap: wrap;
    }

    .tag {
      font-family: 'JetBrains Mono', monospace;
      font-size: 0.75rem;
      background: var(--tag-bg);
      color: var(--accent);
      border: 1px solid rgba(56, 189, 248, 0.2);
      padding: 0.2rem 0.6rem;
      border-radius: 9999px;
    }

    /* Markdown Body Typography */
    .markdown-content {
      font-size: 1.05rem;
      color: #cbd5e1;
    }

    .markdown-content h2 {
      font-size: 1.6rem;
      font-weight: 700;
      color: var(--text);
      letter-spacing: -0.02em;
      margin: 2.5rem 0 1rem;
      padding-bottom: 0.5rem;
      border-bottom: 1px solid var(--border);
    }

    .markdown-content h3 {
      font-size: 1.3rem;
      font-weight: 600;
      color: var(--text);
      margin: 2rem 0 0.75rem;
    }

    .markdown-content p {
      margin-bottom: 1.5rem;
    }

    .markdown-content ul, .markdown-content ol {
      margin: 0 0 1.5rem 1.5rem;
    }

    .markdown-content li {
      margin-bottom: 0.5rem;
    }

    .markdown-content blockquote {
      border-left: 3px solid var(--accent);
      background: var(--bg-surface);
      padding: 1rem 1.25rem;
      border-radius: 0 8px 8px 0;
      margin: 1.5rem 0;
      color: var(--text-muted);
      font-style: italic;
    }

    .markdown-content code {
      font-family: 'JetBrains Mono', monospace;
      font-size: 0.88em;
      background: var(--bg-surface-elevated);
      color: var(--accent);
      padding: 0.2em 0.4em;
      border-radius: 4px;
      border: 1px solid var(--border);
    }

    .markdown-content pre {
      background: var(--bg-surface) !important;
      border: 1px solid var(--border);
      border-radius: 8px;
      padding: 1.25rem;
      overflow-x: auto;
      margin: 1.5rem 0;
    }

    .markdown-content pre code {
      background: transparent;
      padding: 0;
      border: none;
      color: inherit;
    }

    /* Footer */
    footer {
      margin-top: auto;
      border-top: 1px solid var(--border);
      padding: 2.5rem 0;
      text-align: center;
      color: var(--text-muted);
      font-size: 0.875rem;
    }
  </style>
</head>
<body>
  <div class="container">
    <header>
      <a href="/" class="brand">
        <span class="brand-mark"></span>
        Fin <span>&</span> Games
      </a>
      <a href="/" class="back-link">&larr; Back to Overview</a>
    </header>

    <main>
      <article>
        <header class="post-header">
          <div class="post-meta">
            <time datetime={post.data.pubDate.toISOString()}>
              {post.data.pubDate.toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' })}
            </time>
            {post.data.author && <span>• {post.data.author}</span>}
          </div>
          <h1 class="post-title">{post.data.title}</h1>
          {post.data.description && <p class="post-desc">{post.data.description}</p>}
          {post.data.tags && post.data.tags.length > 0 && (
            <div class="tags">
              {post.data.tags.map((tag: string) => (
                <span class="tag">#{tag}</span>
              ))}
            </div>
          )}
        </header>

        <div class="markdown-content">
          <Content />
        </div>
      </article>
    </main>

    <footer>
      <p>&copy; {new Date().getFullYear()} Fin & Games Studio. Built with Astro & Cloudflare Pages.</p>
    </footer>
  </div>
</body>
</html>