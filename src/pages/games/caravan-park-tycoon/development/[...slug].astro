---
import Logo from "../../../../components/Logo.astro";
import BobTheSeagull from "../../../../components/BobTheSeagull.astro";
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
  const posts = await getCollection("gameDevlogs", ({ data }) => !data.draft && data.game === "caravan-park-tycoon");
  // Preserve the IDs currently used by the development index links.
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const date = post.data.pubDate.toLocaleDateString("en-GB", { day: "numeric", month: "long", year: "numeric" });
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1">
  <meta name="description" content={post.data.description}>
  <title>{post.data.title} | Caravan Park Tycoon Devlog</title>
  <style>
    :root{--bg:#081018;--surface:#101c26;--border:#ffffff18;--accent:#fbbf24;--text:#f8fafc;--muted:#a8b6c4}
    *{box-sizing:border-box}body{margin:0;background:var(--bg);color:var(--text);font:16px/1.75 system-ui,sans-serif}
    .wrap{max-width:920px;margin:auto;padding:1.5rem}header{display:flex;justify-content:space-between;align-items:center;gap:1rem;padding-bottom:1.5rem;border-bottom:1px solid var(--border)}
    nav{display:flex;gap:1rem;flex-wrap:wrap}nav a,.back{color:var(--muted);text-decoration:none}nav a:hover,.back:hover{color:var(--accent)}
    main{max-width:780px;margin:auto}.intro{padding:4rem 0 2rem}.eyebrow{color:var(--accent);font:500 .78rem monospace;text-transform:uppercase}
    h1{font-size:clamp(2.5rem,7vw,4.5rem);line-height:1.08;letter-spacing:-.04em;margin:.8rem 0 1rem}.description{font-size:1.2rem;color:var(--muted)}
    .meta{color:var(--muted);font-size:.85rem;margin-top:1rem}.cover{display:block;width:100%;max-height:520px;object-fit:cover;border-radius:16px;margin:1rem 0 2.5rem;border:1px solid var(--border)}
    .prose{font-size:1.05rem}.prose h2,.prose h3{line-height:1.25;margin:2.2rem 0 .8rem}.prose p,.prose ul,.prose ol{margin:1rem 0}
    .prose a{color:var(--accent)}.prose img{display:block;max-width:100%;height:auto;margin:1.5rem auto;border-radius:12px}.prose figure{margin:1.8rem 0}
    .prose figcaption{color:var(--muted);font-size:.9rem;text-align:center;margin-top:-.8rem}.prose pre{overflow:auto;padding:1rem;background:var(--surface);border-radius:10px}
    footer{margin-top:4rem;border-top:1px solid var(--border);padding:2rem 0;color:var(--muted)}
  </style>
</head>
<body><div class="wrap">
  <header><a href="/"><Logo size={42}/></a><nav><a href="/games/caravan-park-tycoon">Game</a><a href="/games/caravan-park-tycoon/development">Development</a><a href="/games/caravan-park-tycoon/roadmap">Roadmap</a></nav></header>
  <main><article>
    <div class="intro"><div class="eyebrow">Caravan Park Tycoon · Development log</div><h1>{post.data.title}</h1><p class="description">{post.data.description}</p><div class="meta">{date} · {post.data.author}{post.data.tags.length ? " · " + post.data.tags.join(" / ") : ""}</div></div>
    {post.data.coverImage && <img class="cover" src={post.data.coverImage} alt={post.data.coverAlt ?? ""} />}
    <div class="prose"><Content /></div>
  </article><p style="margin-top:3rem"><a class="back" href="/games/caravan-park-tycoon/development">← Back to development logs</a></p></main>
  <footer>© {new Date().getFullYear()} Fin & Games</footer>
</div><BobTheSeagull/></body>
</html>
