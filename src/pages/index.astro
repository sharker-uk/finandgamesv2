---
import BobTheSeagull from "../components/BobTheSeagull.astro";
import Logo from "../components/Logo.astro";
import { getCollection } from "astro:content";

const devlogs = (await getCollection("gameDevlogs", ({ data }) => !data.draft && data.game === "caravan-park-tycoon"))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()).slice(0, 3);
const blogPosts = (await getCollection("blog", ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()).slice(0, 3);
---
<!doctype html>
<html lang="en">
<head>
<meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<link rel="icon" type="image/svg+xml" href="/favicon.svg">
<title>Fin & Games | Independent Game Studio</title>
<meta name="description" content="Fin & Games is an independent game studio from Norfolk, UK.">
<link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
<style>
:root{--bg:#081018;--surface:#101c26;--surface2:#162632;--border:rgba(255,255,255,.09);--accent:#fbbf24;--sea:#38bdf8;--text:#f8fafc;--muted:#a8b6c4;--green:#6ee7b7}*{box-sizing:border-box;margin:0;padding:0}body{font-family:'Plus Jakarta Sans',system-ui,sans-serif;color:var(--text);background:var(--bg);background-image:radial-gradient(ellipse 80% 55% at 50% -15%,rgba(56,189,248,.14),transparent 65%);line-height:1.6;min-height:100vh}.wrap{width:min(1120px,calc(100% - 2rem));margin:auto}header{display:flex;align-items:center;justify-content:space-between;gap:1rem;padding:1.5rem 0;border-bottom:1px solid var(--border)}.brand{display:inline-flex}nav{display:flex;flex-wrap:wrap;gap:1.25rem}nav a{color:var(--muted);text-decoration:none;font-size:.92rem;font-weight:600}nav a:hover{color:var(--text)}.support{color:var(--accent)}main section{padding:4.5rem 0}.hero{display:grid;grid-template-columns:1.2fr .8fr;gap:3rem;align-items:center;padding:6rem 0 5rem!important}.eyebrow{color:var(--accent);font:500 .76rem 'JetBrains Mono',monospace;letter-spacing:.1em;text-transform:uppercase;margin-bottom:1rem}.hero h1{font-size:clamp(3.2rem,8vw,6.4rem);line-height:.94;letter-spacing:-.06em;margin-bottom:1.5rem}.lead{font-size:1.2rem;color:var(--muted);max-width:680px}.actions{display:flex;flex-wrap:wrap;gap:.8rem;margin-top:2rem}.button{display:inline-flex;padding:.8rem 1.1rem;border-radius:9px;text-decoration:none;font-weight:700;border:1px solid var(--border);background:var(--surface)}.button:hover{border-color:rgba(251,191,36,.45)}.primary{background:var(--accent);color:#241b05;border-color:var(--accent)}.note{background:var(--surface);border:1px solid var(--border);border-radius:18px;padding:1.7rem;transform:rotate(2deg)}.note .tiny{color:var(--sea);font:500 .72rem 'JetBrains Mono',monospace}.note h2{margin:.6rem 0;font-size:1.7rem}.note p,.card p{color:var(--muted)}.gull{text-align:right;font-size:4rem;margin-top:1rem}.heading{display:flex;justify-content:space-between;align-items:end;gap:1rem;margin-bottom:1.5rem}.heading h2{font-size:clamp(1.8rem,4vw,2.7rem);letter-spacing:-.04em}.link{color:var(--accent);text-decoration:none;font-weight:700}.game{display:grid;grid-template-columns:1fr .75fr;overflow:hidden;border:1px solid var(--border);border-radius:18px;background:var(--surface)}.game-copy{padding:2.2rem}.status{display:inline-block;color:var(--green);background:rgba(110,231,183,.1);border:1px solid rgba(110,231,183,.2);border-radius:999px;padding:.3rem .65rem;font:500 .72rem 'JetBrains Mono',monospace;text-transform:uppercase}.game h3{font-size:clamp(2rem,5vw,3.2rem);line-height:1;margin:1rem 0}.game ul{list-style:none;display:grid;gap:.55rem;margin:1.5rem 0}.game li::before{content:'✓';color:var(--accent);margin-right:.6rem}.art{display:flex;align-items:center;justify-content:center;min-height:320px;border-left:1px solid var(--border);background:linear-gradient(145deg,rgba(56,189,248,.1),rgba(251,191,36,.08))}.sign{padding:2rem;text-align:center;border:2px solid rgba(255,255,255,.18);border-radius:12px;background:rgba(8,16,24,.72)}.sign .sun{font-size:3rem}.sign h4{font-size:1.3rem;margin:.4rem 0}.sign p{font-size:.85rem;color:var(--muted)}.grid{display:grid;grid-template-columns:repeat(3,1fr);gap:1rem}.card{background:var(--surface);border:1px solid var(--border);border-radius:14px;padding:1.5rem;text-decoration:none;color:inherit}.card:hover{background:var(--surface2);border-color:rgba(56,189,248,.3)}.card h3{margin:.5rem 0}.meta{color:var(--muted);font:500 .75rem 'JetBrains Mono',monospace}.empty{color:var(--muted)}footer{margin-top:4rem;padding:2.5rem 0;border-top:1px solid var(--border);color:var(--muted);font-size:.85rem}@media(max-width:800px){.hero,.game{grid-template-columns:1fr}.art{border-left:0;border-top:1px solid var(--border)}.grid{grid-template-columns:1fr}header{align-items:flex-start;flex-direction:column}}
</style>
</head>
<body><div class="wrap">
<header><a href="/" class="brand" aria-label="Fin & Games home"><Logo size={42}/></a><nav><a href="/games">Games</a><a href="/blog">Blog</a><a href="/about">About</a><a href="/npc-builder">Community</a><a class="support" href="/support">Support</a></nav></header>
<main>
<section class="hero"><div><div class="eyebrow">Independent studio · Norfolk, UK</div><h1>Games with a little British character.</h1><p class="lead">Fin & Games is an independent studio building simulation games, strange little systems and stories with a distinctly British flavour.</p><div class="actions"><a class="button primary" href="/games">Explore our games</a><a class="button" href="/blog">Read the blog</a></div></div><aside class="note"><div class="tiny">CURRENTLY IN DEVELOPMENT</div><h2>Caravan Park Tycoon</h2><p>Our first game. One holiday park, an unreasonable number of gulls, and plenty of room to grow.</p><div class="gull">🐦</div></aside></section>
<section><div class="heading"><div><div class="eyebrow">Our games</div><h2>Currently making</h2></div><a class="link" href="/games">All games →</a></div><div class="game"><div class="game-copy"><span class="status">In development</span><h3>Caravan Park Tycoon</h3><p class="lead">Start with an overgrown plot and turn it into a thriving British holiday park. Build pitches, facilities and character while balancing beauty, guests and income.</p><ul><li>Cosy management and simulation</li><li>British seaside holiday-park setting</li><li>Custom tents, caravans and park details</li><li>Characters, secrets and Bob the Mighty</li></ul><a class="button" href="/games/caravan-park-tycoon">View game →</a></div><div class="art"><div class="sign"><div class="sun">☀️</div><h4>FIN & GAMES<br>HOLIDAY PARK</h4><p>Now featuring an unreasonable number of seagulls.</p></div></div></div></section>
<section><div class="heading"><div><div class="eyebrow">From the studio</div><h2>Latest writing</h2></div><a class="link" href="/blog">View all →</a></div><div class="grid">{blogPosts.length ? blogPosts.map(post => <a class="card" href={"/blog/" + post.id}><div class="meta">{post.data.pubDate.toLocaleDateString('en-GB',{day:'numeric',month:'short',year:'numeric'})}</div><h3>{post.data.title}</h3><p>{post.data.description}</p></a>) : <div class="card empty">The studio blog is ready for its first post.</div>}</div></section>
<section><div class="heading"><div><div class="eyebrow">Open development</div><h2>Latest from Caravan Park Tycoon</h2></div><a class="link" href="/games/caravan-park-tycoon/development">All devlogs →</a></div><div class="grid">{devlogs.length ? devlogs.map(post => <a class="card" href={"/games/caravan-park-tycoon/development/" + post.id}><div class="meta">{post.data.pubDate.toLocaleDateString('en-GB',{day:'numeric',month:'short',year:'numeric'})}</div><h3>{post.data.title}</h3><p>{post.data.description}</p></a>) : <div class="card empty">No public devlogs yet. The park is still being assembled.</div>}</div></section>
</main><footer>© {new Date().getFullYear()} Fin & Games · Built with Astro & Cloudflare</footer>
</div><BobTheSeagull/></body></html>