---
import Logo from "../../../components/Logo.astro"; import BobTheSeagull from "../../../components/BobTheSeagull.astro"; import { getCollection } from "astro:content";
const devlogs=(await getCollection("gameDevlogs",({data})=>!data.draft&&data.game==="caravan-park-tycoon")).sort((a,b)=>b.data.pubDate.valueOf()-a.data.pubDate.valueOf()).slice(0,4);
---
<!doctype html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Caravan Park Tycoon | Fin & Games</title><style>:root{--bg:#081018;--surface:#101c26;--border:#ffffff18;--accent:#fbbf24;--text:#f8fafc;--muted:#a8b6c4}*{box-sizing:border-box}body{margin:0;background:var(--bg);color:var(--text);font:16px/1.7 system-ui,sans-serif}.wrap{max-width:1050px;margin:auto;padding:1.5rem}header{display:flex;justify-content:space-between;align-items:center;padding-bottom:1.5rem;border-bottom:1px solid var(--border)}nav{display:flex;gap:1.2rem;flex-wrap:wrap}nav a{color:var(--muted);text-decoration:none}.hero{padding:6rem 0 4rem}.eyebrow{color:var(--accent);font:500 .78rem monospace;text-transform:uppercase}.hero h1{font-size:clamp(3rem,8vw,6rem);line-height:.95;margin:.8rem 0 1.2rem}.lead{font-size:1.25rem;color:var(--muted);max-width:760px}.links{display:flex;gap:.7rem;flex-wrap:wrap;margin-top:2rem}.button{display:inline-block;padding:.75rem 1rem;border:1px solid var(--border);border-radius:9px;text-decoration:none;font-weight:700;color:inherit}.primary{background:var(--accent);color:#241b05;border-color:var(--accent)}.grid{display:grid;grid-template-columns:repeat(3,1fr);gap:1rem}.card{background:var(--surface);border:1px solid var(--border);border-radius:14px;padding:1.5rem}.card p{color:var(--muted)}.devlogs{margin-top:3rem}.devlog{display:block;text-decoration:none;color:inherit;margin-top:1rem}.devlog:hover{border-color:#fbbf2466}.meta{color:var(--muted);font:500 .75rem monospace}footer{margin-top:5rem;border-top:1px solid var(--border);padding:2rem 0;color:var(--muted)}@media(max-width:760px){header{flex-direction:column;align-items:flex-start;gap:1rem}.grid{grid-template-columns:1fr}}</style></head><body><div class="wrap"><header><a href="/"><Logo size={42}/></a><nav><a href="/games">All Games</a><a href="/games/caravan-park-tycoon/development">Development</a><a href="/games/caravan-park-tycoon/features">Features</a><a href="/games/caravan-park-tycoon/roadmap">Roadmap</a><a href="/games/caravan-park-tycoon/expansions">Expansions</a></nav></header><main><section class="hero"><div class="eyebrow">Fin & Games · First game · In development</div><h1>Caravan Park Tycoon</h1><p class="lead">Start with an overgrown plot of land and turn it into a thriving British holiday park. Build pitches, facilities and character while balancing beauty, guests and income.</p><div class="links"><a class="button primary" href="/games/caravan-park-tycoon/development">Development log</a><a class="button" href="/games/caravan-park-tycoon/roadmap">Roadmap</a><a class="button" href="/games/caravan-park-tycoon/expansions">Expansions</a></div></section><section class="grid"><article class="card"><h2>🌳 Shape the land</h2><p>Clear trees and overgrowth, decide what stays, and turn an empty plot into a park.</p></article><article class="card"><h2>🚐 Build the park</h2><p>Create pitches, facilities, utilities and spaces that make guests want to stay.</p></article><article class="card"><h2>👑 Mind the King</h2><p>Bob the Mighty is King of the Seagulls. Treat him accordingly.</p></article></section><section class="devlogs"><div class="eyebrow">Open development</div><h2>Latest development logs</h2>{devlogs.length?devlogs.map(post=><a class="card devlog" href={"/games/caravan-park-tycoon/development/"+post.id}><div class="meta">{post.data.pubDate.toLocaleDateString('en-GB',{day:'numeric',month:'short',year:'numeric'})}</div><h3>{post.data.title}</h3><p>{post.data.description}</p></a>):<article class="card devlog"><p>No public devlogs yet.</p></article>}</section></main><footer>© {new Date().getFullYear()} Fin & Games · <a href="/">Studio home</a></footer></div><BobTheSeagull/></body></html>