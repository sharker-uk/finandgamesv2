<!doctype html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Games | Fin & Games</title><style>:root{--bg:#081018;--surface:#101c26;--border:#ffffff18;--accent:#fbbf24;--text:#f8fafc;--muted:#a8b6c4}*{box-sizing:border-box}body{margin:0;background:var(--bg);color:var(--text);font:16px/1.7 system-ui,sans-serif}.wrap{max-width:1050px;margin:auto;padding:1.5rem}header{display:flex;justify-content:space-between;align-items:center;padding-bottom:1.5rem;border-bottom:1px solid var(--border)}nav{display:flex;gap:1.2rem;flex-wrap:wrap}nav a{color:var(--muted);text-decoration:none}main{padding:5rem 0}.eyebrow{color:var(--accent);font:500 .78rem monospace;text-transform:uppercase}.hero h1{font-size:clamp(3rem,8vw,5.5rem);line-height:.95;margin:.8rem 0}.lead{font-size:1.2rem;color:var(--muted);max-width:720px}.card{margin-top:2.5rem;background:var(--surface);border:1px solid var(--border);border-radius:18px;padding:2.2rem}.card h2{font-size:2.5rem;margin:.7rem 0}.card p{color:var(--muted);max-width:700px}.status{color:#6ee7b7;font:500 .75rem monospace;text-transform:uppercase}.button{display:inline-block;margin-top:1rem;padding:.75rem 1rem;border-radius:8px;background:var(--accent);color:#241b05;text-decoration:none;font-weight:700}footer{border-top:1px solid var(--border);padding:2rem 0;color:var(--muted)}@media(max-width:700px){header{flex-direction:column;align-items:flex-start;gap:1rem}}</style></head><body><div class="wrap"><header><a href="/"><Logo size={42}/></a><nav><a href="/games">Games</a><a href="/blog">Blog</a><a href="/about">About</a><a href="/npc-builder">Community</a><a href="/support">Support</a></nav></header><main><section class="hero"><div class="eyebrow">Fin & Games</div><h1>Our games.</h1><p class="lead">The studio is bigger than any one project. Current games, future games and expansions live here.</p></section><article class="card"><span class="status">In development · First game</span><h2>Caravan Park Tycoon</h2><p>A cosy management game about turning an overgrown plot into a thriving British holiday park. Build pitches and facilities, manage beauty and income, meet guests and discover the oddities hiding around the park.</p><a class="button" href="/games/caravan-park-tycoon">Explore Caravan Park Tycoon →</a></article></main><footer>© {new Date().getFullYear()} Fin & Games</footer></div><BobTheSeagull/></body></html>