---
import BobTheSeagull from "../components/BobTheSeagull.astro";
import Logo from "../components/Logo.astro";
import { getCollection } from "astro:content";

const devlogs = (await getCollection("gameDevlogs", ({ data }) => !data.draft && data.game === "caravan-park-tycoon"))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()).slice(0, 3);
const blogPosts = (await getCollection("blog", ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()).slice(0, 3);
---
<!doctype html>
<html lang="en-GB">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="theme-color" content="#f5f0e6">
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
  <title>Fin & Games — Proper games. Peculiar people.</title>
  <meta name="description" content="An independent British game studio making thoughtful games with character, a little seaside spirit and the occasional suspicious seagull.">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=DM+Sans:wght@400;500;600;700;800&family=Fraunces:opsz,wght,SOFT,WONK@9..144,600,20,1;9..144,700,20,1;9..144,800,20,1&display=swap" rel="stylesheet">
  <style>
    :root{color-scheme:light;--paper:#f5f0e6;--paper-deep:#eae1d1;--ink:#202c25;--muted:#667168;--green:#254d3b;--green-dark:#18382b;--orange:#d85b36;--yellow:#e9bd59;--blue:#a9cbd0;--line:rgba(32,44,37,.17);--serif:'Fraunces',Georgia,serif;--sans:'DM Sans',system-ui,sans-serif;--mono:'DM Mono',monospace}
    *{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;background:var(--paper);color:var(--ink);font-family:var(--sans);line-height:1.6}a{color:inherit}a:focus-visible{outline:3px solid var(--orange);outline-offset:4px}.wrap{width:min(1200px,calc(100% - 3rem));margin-inline:auto}
    .topline{background:var(--green-dark);color:#f8f1e5;font:500 .72rem var(--mono);letter-spacing:.07em;text-align:center;padding:.55rem 1rem}.topline span{color:var(--yellow)}
    header{display:flex;align-items:center;justify-content:space-between;gap:2rem;padding:1.1rem 0;border-bottom:1px solid var(--line)}.brand{display:inline-flex;flex-shrink:0}.nav{display:flex;align-items:center;flex-wrap:wrap;gap:clamp(.8rem,2.2vw,1.8rem)}.nav a{text-decoration:none;font-size:.88rem;font-weight:700}.nav a:not(.nav-cta):hover{text-decoration:underline;text-decoration-color:var(--orange);text-underline-offset:5px}.nav-cta{background:var(--orange);color:#fffaf2;padding:.7rem 1rem;border-radius:3px}
    main section{padding:5.5rem 0}.hero{display:grid;grid-template-columns:minmax(0,1.15fr) minmax(300px,.85fr);gap:clamp(2rem,5vw,5rem);align-items:center;padding:5.8rem 0 5rem!important}.eyebrow{display:flex;align-items:center;gap:.65rem;font:500 .72rem var(--mono);letter-spacing:.09em;text-transform:uppercase;color:var(--green);margin-bottom:1.1rem}.eyebrow:before{content:"";width:1.8rem;height:2px;background:var(--orange)}h1,h2,h3,p{margin-top:0}.hero h1{font:800 clamp(3.5rem,7.4vw,7.1rem)/.91 var(--serif);letter-spacing:-.065em;max-width:760px;margin-bottom:1.5rem}.hero h1 em{font-weight:600;color:var(--orange)}.lead{font-size:clamp(1.05rem,1.6vw,1.2rem);line-height:1.7;color:#505d53;max-width:650px}.actions{display:flex;flex-wrap:wrap;gap:.75rem;margin-top:2rem}.button{display:inline-flex;align-items:center;justify-content:center;gap:.5rem;padding:.9rem 1.15rem;border:1px solid var(--green);border-radius:3px;text-decoration:none;font-weight:800;font-size:.9rem;transition:transform .15s,background .15s}.button:hover{transform:translateY(-2px)}.button-primary{background:var(--green);color:#fffaf2}.button-secondary{background:transparent;color:var(--green)}
    .hero-art{position:relative;min-height:440px;background:var(--blue);border:1px solid var(--ink);padding:1.25rem;overflow:hidden;isolation:isolate}.hero-art:before{content:"";position:absolute;inset:0;background:repeating-linear-gradient(135deg,transparent 0 19px,rgba(32,44,37,.055) 20px 21px);z-index:-1}.art-stamp{position:absolute;top:1.3rem;left:1.3rem;background:var(--paper);padding:.55rem .7rem;font:500 .65rem var(--mono);text-transform:uppercase;letter-spacing:.06em;transform:rotate(-3deg)}.sun{position:absolute;right:2.1rem;top:2.3rem;width:85px;height:85px;background:var(--yellow);border:1px solid var(--ink);border-radius:50%}.hill{position:absolute;bottom:-3rem;width:125%;height:58%;left:-12%;border:1px solid var(--ink);border-radius:50% 50% 0 0;background:var(--green);transform:rotate(-8deg)}.hill-back{bottom:5.5rem;left:15%;height:34%;background:#6d9b7b;transform:rotate(8deg)}.park-sign{position:absolute;bottom:2.1rem;left:50%;transform:translateX(-50%) rotate(-2deg);width:min(75%,280px);background:var(--paper);border:2px solid var(--ink);padding:1rem;text-align:center;box-shadow:6px 6px 0 rgba(32,44,37,.18)}.park-sign small{font:500 .62rem var(--mono);letter-spacing:.09em}.park-sign strong{display:block;font:800 clamp(1.45rem,3vw,2rem)/1 var(--serif);margin:.45rem 0}.park-sign span{font-size:.75rem;color:var(--muted)}.gull-note{position:absolute;right:1.2rem;top:8rem;background:var(--orange);color:white;border:1px solid var(--ink);padding:.65rem .8rem;max-width:145px;font:500 .68rem var(--mono);transform:rotate(4deg)}.gull-note:after{content:"";position:absolute;left:-8px;bottom:10px;border-width:7px 8px 7px 0;border-style:solid;border-color:transparent var(--ink) transparent transparent}
    .ticker{background:var(--yellow);border-block:1px solid var(--ink);overflow:hidden}.ticker-inner{display:flex;justify-content:space-around;gap:1.5rem;padding:.9rem 0;font:500 .7rem var(--mono);text-transform:uppercase;letter-spacing:.08em;white-space:nowrap}.ticker b{font-weight:500}.ticker i{font-style:normal;color:var(--orange)}
    .section-head{display:flex;align-items:end;justify-content:space-between;gap:1.5rem;margin-bottom:2rem}.section-head h2{font:700 clamp(2.3rem,5vw,4.2rem)/1 var(--serif);letter-spacing:-.05em;margin-bottom:0}.section-head p{color:var(--muted);max-width:440px;margin:.75rem 0 0}.text-link{font-weight:800;text-decoration-thickness:1px;text-underline-offset:5px;text-decoration-color:var(--orange);white-space:nowrap}.text-link:hover{color:var(--orange)}
    .game-feature{display:grid;grid-template-columns:1.05fr .95fr;border:1px solid var(--ink);background:#fffaf2}.game-copy{padding:clamp(1.5rem,4vw,3.3rem)}.status{display:inline-flex;align-items:center;gap:.45rem;background:#e0e9d9;border:1px solid #8da58d;padding:.35rem .6rem;font:500 .67rem var(--mono);text-transform:uppercase;letter-spacing:.04em}.status:before{content:"";width:7px;height:7px;background:var(--green);border-radius:50%}.game-copy h3{font:700 clamp(2.7rem,5.2vw,5rem)/.96 var(--serif);letter-spacing:-.055em;margin:1.2rem 0}.game-copy p{color:#566258;max-width:580px}.feature-list{display:grid;grid-template-columns:1fr 1fr;gap:.7rem 1rem;list-style:none;padding:0;margin:1.6rem 0 2rem}.feature-list li{font-size:.86rem;font-weight:700;padding-left:1.2rem;position:relative}.feature-list li:before{content:"↗";position:absolute;left:0;color:var(--orange)}.game-art{position:relative;min-height:420px;background:var(--green);overflow:hidden;display:grid;place-items:center}.game-art:before{content:"";position:absolute;inset:0;background:linear-gradient(160deg,transparent 45%,rgba(0,0,0,.2)),repeating-linear-gradient(90deg,transparent 0 35px,rgba(255,255,255,.05) 36px 37px)}.cabin{position:relative;width:68%;max-width:360px;aspect-ratio:1.05/1;background:#d5aa73;border:2px solid var(--ink);transform:rotate(-3deg);box-shadow:12px 12px 0 rgba(0,0,0,.15)}.cabin-roof{position:absolute;left:-8%;top:-19%;width:116%;height:28%;background:var(--orange);border:2px solid var(--ink);clip-path:polygon(50% 0,100% 100%,0 100%)}.cabin-window{position:absolute;top:20%;left:12%;width:25%;height:24%;background:var(--blue);border:2px solid var(--ink)}.cabin-window:after{content:"";position:absolute;left:50%;height:100%;border-left:2px solid var(--ink)}.cabin-door{position:absolute;right:13%;bottom:0;width:25%;height:50%;background:#86543b;border:2px solid var(--ink);border-bottom:0}.cabin-door:after{content:"";position:absolute;right:12%;top:50%;width:5px;height:5px;background:var(--yellow);border:1px solid var(--ink);border-radius:50%}.cabin-label{position:absolute;left:50%;bottom:-2.4rem;transform:translateX(-50%) rotate(3deg);background:var(--paper);border:1px solid var(--ink);padding:.4rem .6rem;white-space:nowrap;font:500 .65rem var(--mono)}.bird-silhouette{position:absolute;right:12%;top:15%;font-size:3.2rem;filter:grayscale(1);transform:rotate(-12deg)}.game-art-note{position:absolute;left:1.2rem;top:1.2rem;color:#f8f1e5;font:500 .68rem var(--mono);text-transform:uppercase;letter-spacing:.07em}
    .writing{background:var(--paper-deep);border-block:1px solid var(--line)}.cards{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:1rem}.story-card{display:flex;flex-direction:column;min-height:250px;padding:1.4rem;background:var(--paper);border:1px solid var(--line);text-decoration:none;transition:transform .15s,border-color .15s}.story-card:hover{transform:translateY(-3px);border-color:var(--orange)}.story-meta{font:500 .67rem var(--mono);text-transform:uppercase;letter-spacing:.04em;color:var(--muted)}.story-card h3{font:700 1.7rem/1.12 var(--serif);letter-spacing:-.025em;margin:1rem 0 .7rem}.story-card p{color:#58645a;font-size:.91rem}.story-card .read-more{margin-top:auto;padding-top:1.2rem;font-size:.82rem;font-weight:800;color:var(--green)}.empty-card{border:1px dashed var(--line);padding:1.5rem;color:var(--muted);background:rgba(255,250,242,.5)}
    .bob-band{display:grid;grid-template-columns:1fr auto;align-items:center;gap:2rem;background:var(--green);color:#fffaf2;padding:clamp(1.6rem,4vw,3rem);border:1px solid var(--ink)}.bob-band .eyebrow{color:var(--yellow)}.bob-band h2{font:700 clamp(2rem,4vw,3.5rem)/1 var(--serif);letter-spacing:-.04em;margin-bottom:.8rem}.bob-band p{max-width:700px;color:#d7e1d8;margin-bottom:0}.bob-stamp{width:120px;height:120px;border:2px dashed var(--yellow);border-radius:50%;display:grid;place-items:center;font-size:3.4rem;transform:rotate(10deg)}.bob-band .text-link{display:inline-block;margin-top:1.1rem;color:var(--yellow)}
    footer{background:var(--green-dark);color:#e6e8dd;margin-top:0;padding:2.7rem 0}.footer-inner{display:flex;justify-content:space-between;align-items:center;gap:1.5rem}.footer-brand{font:700 1.2rem var(--serif)}footer p{font-size:.8rem;color:#b8c7bb;margin:.4rem 0 0}footer nav{display:flex;flex-wrap:wrap;gap:1.2rem}footer nav a{font-size:.8rem;color:#e6e8dd;text-decoration:none}footer nav a:hover{text-decoration:underline}
    @media(max-width:850px){.wrap{width:min(100% - 2rem,700px)}header{align-items:flex-start}.nav{justify-content:flex-end;gap:.7rem 1rem}.hero{grid-template-columns:1fr;padding:4rem 0!important}.hero-art{min-height:380px}.game-feature{grid-template-columns:1fr}.game-art{min-height:340px}.cards{grid-template-columns:1fr 1fr}main section{padding:4rem 0}.ticker-inner{justify-content:flex-start;overflow:hidden}.section-head{align-items:flex-start;flex-direction:column}.section-head .text-link{white-space:normal}}
    @media(max-width:560px){.wrap{width:calc(100% - 1.25rem)}header{flex-direction:column;gap:1rem;padding:1rem 0}.nav{justify-content:flex-start}.nav a{font-size:.82rem}.hero h1{font-size:clamp(3.1rem,15vw,5rem)}.hero-art{min-height:330px}.gull-note{top:7rem;right:.7rem}.park-sign{bottom:1.4rem}.feature-list{grid-template-columns:1fr}.cards{grid-template-columns:1fr}.story-card{min-height:unset}.bob-band{grid-template-columns:1fr}.bob-stamp{width:84px;height:84px;font-size:2.4rem}.footer-inner{align-items:flex-start;flex-direction:column}.ticker-inner{font-size:.62rem}}
    @media(prefers-reduced-motion:reduce){html{scroll-behavior:auto}*,*::before,*::after{transition:none!important;animation:none!important}}
  </style>
</head>
<body>
  <div class="topline">INDEPENDENT GAMES STUDIO <span>✳</span> NORFOLK, ENGLAND <span>✳</span> TEA-POWERED, BUG-TESTED</div>
  <main>
  <div class="wrap">
    <header>
      <a href="/" class="brand" aria-label="Fin & Games home"><Logo size={46}/></a>
      <nav class="nav" aria-label="Main navigation">
        <a href="/games">Games</a><a href="/blog">Studio blog</a><a href="/news">News</a><a href="/about">About</a><a href="/npc-builder">Community</a><a class="nav-cta" href="/support">Support us ↗</a>
      </nav>
    </header>
      <section class="hero">
        <div>
          <div class="eyebrow">Small studio. Properly big ideas.</div>
          <h1>Proper games.<br><em>Peculiar people.</em></h1>
          <p class="lead">We make thoughtful games with character, a distinctly British flavour and the occasional seagull who seems to know a little too much.</p>
          <div class="actions"><a class="button button-primary" href="/games">Have a look at our games ↗</a><a class="button button-secondary" href="/about">Meet the studio</a></div>
        </div>
        <div class="hero-art" role="img" aria-label="Illustrated British seaside holiday park, rolling green hills, sunshine and a suspicious seagull">
          <div class="art-stamp">A little bit independent</div><div class="sun"></div><div class="hill"></div><div class="hill hill-back"></div>
          <div class="gull-note">PARK INSPECTOR<br>NO BADGE REQUIRED</div>
          <div class="park-sign"><small>WELCOME TO</small><strong>FIN & GAMES</strong><span>Mind the gulls. They know the rules.</span></div>
        </div>
      </section>
  </div>
  <div class="ticker" aria-label="Studio values"><div class="wrap ticker-inner"><b>Made in Britain <i>✳</i></b><b>Independent by nature <i>✳</i></b><b>Thoughtful by design <i>✳</i></b><b>Seagull oversight included</b></div></div>
  <div class="wrap">
      <section>
        <div class="section-head"><div><div class="eyebrow">Currently under construction</div><h2>Our sort of games.</h2><p>We like systems you can get lost in, places that feel lived in, and details that reward a second look.</p></div><a class="text-link" href="/games">All games →</a></div>
        <article class="game-feature">
          <div class="game-copy"><span class="status">In development</span><h3>Caravan Park<br>Tycoon</h3><p>Start with an overgrown plot and turn it into a thriving British holiday park. Build pitches and facilities, keep guests happy, balance the books and try to maintain order in a place with a frankly unreasonable seagull population.</p>
            <ul class="feature-list"><li>Cosy management and simulation</li><li>British seaside holiday-park setting</li><li>Build, improve and make it your own</li><li>Characters, secrets and Bob the Mighty</li></ul><a class="button button-primary" href="/games/caravan-park-tycoon">Explore the game ↗</a>
          </div>
          <div class="game-art" role="img" aria-label="Stylised holiday cabin beneath a bright sky">
            <div class="game-art-note">The park is coming along nicely. Mostly.</div><div class="bird-silhouette" aria-hidden="true">✦</div><div class="cabin"><div class="cabin-roof"></div><div class="cabin-window"></div><div class="cabin-door"></div><div class="cabin-label">NICE LITTLE PITCH, THAT</div></div>
          </div>
        </article>
      </section>
      <section class="writing">
        <div class="section-head"><div><div class="eyebrow">Notes from the studio</div><h2>Things we've been thinking about.</h2><p>Ideas, lessons, experiments and the occasional admission that something took longer than expected.</p></div><a class="text-link" href="/blog">All studio writing →</a></div>
        <div class="cards">{blogPosts.length ? blogPosts.map(post => <a class="story-card" href={"/blog/" + post.id}><div class="story-meta">{post.data.pubDate.toLocaleDateString('en-GB',{day:'numeric',month:'short',year:'numeric'})} · Studio blog</div><h3>{post.data.title}</h3><p>{post.data.description}</p><span class="read-more">Read the article ↗</span></a>) : <div class="empty-card">No studio posts just yet. We're working on it. The kettle is on.</div>}</div>
      </section>
      <section>
        <div class="section-head"><div><div class="eyebrow">Open development</div><h2>From the park floor.</h2><p>Real progress, real problems, and the occasional suspicious bird-shaped interruption.</p></div><a class="text-link" href="/games/caravan-park-tycoon/development">All devlogs →</a></div>
        <div class="cards">{devlogs.length ? devlogs.map(post => <a class="story-card" href={"/games/caravan-park-tycoon/development/" + post.id}><div class="story-meta">{post.data.pubDate.toLocaleDateString('en-GB',{day:'numeric',month:'short',year:'numeric'})} · Devlog</div><h3>{post.data.title}</h3><p>{post.data.description}</p><span class="read-more">Read the update ↗</span></a>) : <div class="empty-card">No public devlogs yet. The park is still being assembled. Please keep behind the temporary fencing.</div>}</div>
      </section>
      <section>
        <div class="bob-band"><div><div class="eyebrow">Unofficial. Uninvited. Unreasonably confident.</div><h2>Bob the Mighty is watching.</h2><p>Some studios have mascots. We have a seagull with questionable boundaries and an apparent disregard for normal park procedures. If you see him, no you didn't.</p><a class="text-link" href="/games/caravan-park-tycoon">Find out about the park →</a></div><div class="bob-stamp" aria-hidden="true">🐦</div></div>
      </section>
  </div>
  </main>
  <footer><div class="wrap"><div class="footer-inner"><div><div class="footer-brand">Fin & Games</div><p>Independent games. British character. Norfolk, England.<br>© {new Date().getFullYear()} Fin & Games.</p></div><nav aria-label="Footer navigation"><a href="/games">Games</a><a href="/blog">Blog</a><a href="/news">News</a><a href="/about">About</a><a href="/support">Support</a></nav></div></div></footer>
  <BobTheSeagull/>
</body>
</html>
