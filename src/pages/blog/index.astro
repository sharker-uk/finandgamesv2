---
import Logo from "../../components/Logo.astro"; import BobTheSeagull from "../../components/BobTheSeagull.astro"; import { getCollection } from "astro:content";
const posts=(await getCollection("blog",({data})=>!data.draft)).sort((a,b)=>b.data.pubDate.valueOf()-a.data.pubDate.valueOf());
---
<!doctype html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Blog | Fin & Games</title><style>
:root{--bg:#081018;--surface:#101c26;--border:#ffffff18;--accent:#fbbf24;--text:#f8fafc;--muted:#a8b6c4}*{box-sizing:border-box}body{margin:0;background:var(--bg);color:var(--text);font:16px/1.7 system-ui,sans-serif}.wrap{max-width:900px;margin:auto;padding:1.5rem}header{display:flex;justify-content:space-between;align-items:center;padding-bottom:1.5rem;border-bottom:1px solid var(--border)}nav{display:flex;gap:1.2rem;flex-wrap:wrap}nav a{color:var(--muted);text-decoration:none}.hero{padding:5rem 0 3rem}.eyebrow{color:var(--accent);font:500 .78rem monospace;text-transform:uppercase}.hero h1{font-size:clamp(3rem,7vw,5rem);line-height:1;margin:.8rem 0}.lead{color:var(--muted);font-size:1.15rem}.post{display:block;text-decoration:none;color:inherit;background:var(--surface);border:1px solid var(--border);border-radius:14px;padding:1.5rem;margin-bottom:1rem}.post:hover{border-color:#fbbf2466}.meta{color:var(--muted);font:500 .75rem monospace}.post h2{margin:.5rem 0}.post p{color:var(--muted)}footer{margin-top:4rem;border-top:1px solid var(--border);padding:2rem 0;color:var(--muted)}
</style></head><body><div class="wrap"><header><a href="/"><Logo size={42}/></a><nav><a href="/games">Games</a><a href="/blog">Blog</a><a href="/about">About</a><a href="/npc-builder">Community</a><a href="/support">Support</a></nav></header><main><section class="hero"><div class="eyebrow">Fin & Games · Studio writing</div><h1>The studio blog.</h1><p class="lead">Thoughts on building games, running a tiny studio, technology, design and the occasional decision that looked much better at 2am.</p></section>{posts.length?posts.map(post=><a class="post" href={"/blog/"+post.id}><div class="meta">{post.data.pubDate.toLocaleDateString('en-GB',{day:'numeric',month:'short',year:'numeric'})} · {post.data.author}</div><h2>{post.data.title}</h2><p>{post.data.description}</p></a>):<article class="post"><h2>Nothing published yet.</h2><p>The blog is ready. The studio is still finding things worth saying.</p></article>}</main><footer>© {new Date().getFullYear()} Fin & Games</footer></div><BobTheSeagull/></body></html>