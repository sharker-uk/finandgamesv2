---
import Logo from "../../../../components/Logo.astro"; import BobTheSeagull from "../../../../components/BobTheSeagull.astro"; import { getCollection, render } from "astro:content";
export async function getStaticPaths(){const posts=await getCollection("gameDevlogs",({data})=>!data.draft&&data.game==="caravan-park-tycoon");return posts.map(post=>({params:{slug:post.id},props:{post}}));}
const {post}=Astro.props;const {Content}=await render(post);
---
<!doctype html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>{post.data.title} | Caravan Park Tycoon</title><style>:root{--bg:#081018;--surface:#101c26;--border:#ffffff18;--accent:#fbbf24;--text:#f8fafc;--muted:#a8b6c4}*{box-sizing:border-box}body{margin:0;background:var(--bg);color:var(--text);font:16px/1.8 system-ui,sans-serif}.wrap{max-width:820px;margin:auto;padding:1.5rem}header{display:flex;justify-content:space-between;padding-bottom:1.5rem;border-bottom:1px solid var(--border)}nav{display:flex;gap:1rem}nav a{color:var(--muted);text-decoration:none}.back{display:inline-block;margin:3rem 0 1rem;color:var(--accent)}.meta{color:var(--muted);font:500 .75rem monospace}.post h1{font-size:clamp(2.5rem,6vw,4rem);line-height:1.05}.desc{color:var(--muted);font-size:1.15rem;border-bottom:1px solid var(--border);padding-bottom:2rem}.content{margin-top:2.5rem}.content h2{margin:2.5rem 0 .8rem}.content a{color:var(--accent)}footer{margin-top:5rem;border-top:1px solid var(--border);padding:2rem 0;color:var(--muted)}</style></head><body><div class="wrap"><header><a href="/"><Logo size={42}/></a><nav><a href="/games/caravan-park-tycoon">Caravan Park Tycoon</a><a href="/games">All Games</a></nav></header><a class="back" href="/games/caravan-park-tycoon/development">← All development logs</a><article class="post"><div class="meta">{post.data.pubDate.toLocaleDateString('en-GB',{day:'numeric',month:'long',year:'numeric'})} · {post.data.author}</div><h1>{post.data.title}</h1><p class="desc">{post.data.description}</p><div class="content"><Content/></div></article><footer>© {new Date().getFullYear()} Fin & Games</footer></div><BobTheSeagull/></body></html>